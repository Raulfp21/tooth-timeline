<!DOCTYPE html>
<html><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Attrition — Real Teeth</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#0d1117;color:#e6edf3;font-family:-apple-system,sans-serif;margin:0;font-size:14px;line-height:1.5}
.nav{display:flex;gap:5px;padding:10px;flex-wrap:wrap;background:#161b22;border-bottom:1px solid #30363d;position:sticky;top:0;z-index:10}
.nav a{padding:5px 9px;border-radius:6px;background:#0d1117;color:#e6edf3;text-decoration:none;font-size:11px;border:1px solid #30363d}
.nav a.active{background:#d2a8ff;color:#0d1117;border-color:#d2a8ff}
.wrap{padding:12px;max-width:960px;margin:0 auto}
h1{font-size:16px;margin:0 0 4px}
.sub{font-size:11px;color:#8b949e;margin-bottom:12px}
.viewer{position:relative;background:radial-gradient(circle at center,#1a2029,#0d1117);border-radius:10px;height:48vh;min-height:320px;overflow:hidden;touch-action:none}
.viewer canvas{display:block;width:100%;height:100%}
.viewer .hint{position:absolute;top:8px;left:10px;font-size:10px;color:#8b949e;background:rgba(0,0,0,.5);padding:3px 8px;border-radius:4px;pointer-events:none;z-index:2}
.viewer .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#8b949e;font-size:12px;background:rgba(13,17,23,.7);pointer-events:none}
.controls{background:#161b22;border-radius:10px;padding:14px;margin-top:12px}
.ctrl-title{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.ctrl-title .name{font-size:15px;font-weight:700;color:#f0883e}
.ctrl-title .val{font-size:13px;color:#d2a8ff;font-weight:700}
input[type=range]{width:100%;-webkit-appearance:none;background:transparent;height:24px;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:5px;background:#30363d;border-radius:3px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;border-radius:50%;background:#f0883e;border:2px solid #0d1117;margin-top:-9px;cursor:pointer}
.scale{display:flex;justify-content:space-between;font-size:10px;color:#484f58;padding:2px 2px 0}
.stage-info{margin-top:10px;padding:10px;background:#0d1117;border-radius:8px;font-size:12.5px;line-height:1.55;color:#c9d1d9;min-height:70px}
.stage-info strong{color:#f0883e}
.presets{display:flex;gap:5px;margin-top:10px;flex-wrap:wrap}
.presets button{flex:1;min-width:55px;padding:8px 4px;border-radius:6px;border:1px solid #30363d;background:#0d1117;color:#e6edf3;font-family:inherit;font-size:11px;font-weight:600;cursor:pointer}
.presets button:active,.presets button.on{background:#f0883e;color:#0d1117}
</style>
</head>
<body>

<div class="nav">
<a href="index.html">Timeline</a>
<a href="learn.html">Learn</a>
<a href="tooth3d.html">3D</a>
<a href="label3d.html">Label</a>
<a href="viva.html">Viva</a>
<a href="gustafson.html">Gustafson</a>
<a href="attrition.html" class="active">Attrition</a>
<a href="periodontosis.html" style="padding:5px 9px;border-radius:6px;background:#0d1117;color:#e6edf3;text-decoration:none;font-size:11px;border:1px solid #30363d">Periodontosis</a>
<a href="secondary.html">Secondary dentin</a>
<a href="resorption.html">Root resorption</a>
<a href="transparency.html">Transparency</a>
<a href="cementum.html">Cementum</a>
<a href="assignments.html">Exam</a>
<a href="clinic.html">Clinic</a>
</div>

<div class="wrap">
<h1>Attrition — Lower Incisors</h1>
<div class="sub">Drag the slider. Watch the incisal edge wear down and yellow dentin appear.</div>

<div class="viewer" id="viewer">
  <div class="hint">drag to rotate · pinch to zoom</div>
  <div class="loading" id="loading">Loading teeth…</div>
</div>

<div class="controls">
  <div class="ctrl-title">
    <span class="name">A — Attrition</span>
    <span class="val" id="valDisplay">0 / 3</span>
  </div>
  <input type="range" min="0" max="3" step="1" value="0" id="slider">
  <div class="scale"><span>0 · none</span><span>1 · begin</span><span>2 · obvious</span><span>3 · max</span></div>
  <div class="stage-info" id="stageInfo"></div>
  <div class="presets">
    <button data-v="0">Young</button>
    <button data-v="1">Early</button>
    <button data-v="2">Middle</button>
    <button data-v="3">Advanced</button>
  </div>
  <div class="presets">
    <button id="secBtn" disabled aria-pressed="false">✂ Section: cut through the middle incisor</button>
  </div>
</div>
</div>

<script type="importmap">
{ "imports": {
    "three": "./libs/three.module.js",
    "three/addons/loaders/GLTFLoader.js": "./libs/GLTFLoader.js",
    "three/addons/controls/OrbitControls.js": "./libs/OrbitControls.js"
} }
</script>

<script type="module">
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const FOLDER = './models/';

// Lower anterior teeth as requested
const TEETH = [
  { file: 'mandibular_left_central_incisor', x: -0.75, z: 0.10,  ry: 0.20 },
  { file: 'mandibular_left_lateral_incisor', x:  0.10, z: 0.00,  ry: 0.00 },
  { file: 'mandibular_left_canine',          x:  1.00, z: -0.15, ry: -0.30 },
];

// Fraction of the crown worn away at each stage
const WEAR = [0, 0.10, 0.30, 0.62];

const MESSAGES = [
  '<strong>Stage 0 — no change.</strong> Incisal edges intact. Enamel fully covers the crown.',
  '<strong>Stage 1 — beginning.</strong> Slight loss of enamel on the incisal edge. A thin yellow line of dentin may be visible.',
  '<strong>Stage 2 — obvious.</strong> Clear loss of incisal enamel with a broad exposed band of yellow dentin. Incisal edge noticeably shortened.',
  '<strong>Stage 3 — maximum.</strong> Severe wear down to the level of the pulp. A small reddish spot marks where the pulp chamber has been exposed.',
];

const viewer = document.getElementById('viewer');
const loading = document.getElementById('loading');

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, stencil: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(viewer.clientWidth, viewer.clientHeight);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.localClippingEnabled = true;
viewer.appendChild(renderer.domElement);

const scene = new THREE.Scene();

const camera = new THREE.PerspectiveCamera(38, viewer.clientWidth / viewer.clientHeight, 0.01, 200);
camera.position.set(0.12, 2.2, 4.0);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.enablePan = false;
controls.target.set(0.12, 0, 0);
controls.minDistance = 2;
controls.maxDistance = 9;
controls.minPolarAngle = 0.2;
controls.maxPolarAngle = Math.PI / 1.8;
// NO auto-rotation

scene.add(new THREE.AmbientLight(0xffffff, 0.75));
const key = new THREE.DirectionalLight(0xffffff, 1.15);
key.position.set(2, 5, 4); scene.add(key);
const fill = new THREE.DirectionalLight(0xaaccff, 0.5);
fill.position.set(-4, 1, -2); scene.add(fill);
const rim = new THREE.DirectionalLight(0xffccaa, 0.35);
rim.position.set(0, -3, -3); scene.add(rim);

const loader = new GLTFLoader();
const toothGroup = new THREE.Group();
scene.add(toothGroup);

const teeth = [];
let level = 0;

// SECTION TUNING — lengths below are fractions unless stated otherwise.
const SEC_TOOTH_INDEX = 1; // Index in TEETH identifying the middle incisor.
const SEC_CUT_OFFSET = 0; // Cut displacement from centre, as a fraction of tooth width.
const SEC_ENAMEL_THICKNESS = 0.045; // Enamel inset as a fraction of existing crown height.
const SEC_MIN_CORE_SCALE = 0.20; // Minimum inset scale, preventing inverted geometry.
const SEC_PULP_HALF_WIDTH = 0.13; // Chamber half-width as a fraction of tooth depth.
const SEC_CANAL_HALF_WIDTH = 0.020; // Canal half-width as a fraction of tooth depth.
const SEC_PULP_Z_SHIFT = 0; // Pulp centre offset as a fraction of tooth depth.
const SEC_HORN_DEPTH = 0.44; // Horn depth below topY in crown heights; between stages 2 and 3.
const SEC_CHAMBER_DEPTH = 0.70; // Widest chamber depth below topY in crown heights.
const SEC_CANAL_JOIN = 0.22; // Canal transition height above root tip in total tooth heights.
const SEC_APEX_MARGIN = 0.055; // Pulp endpoint clearance above root tip in total tooth heights.
const SEC_PULP_SEGMENTS = 20; // Curve subdivisions for the flat pulp shape.
const SEC_CAP_SCALE = 1.10; // Cap rectangle coverage relative to the tooth bounding box.
const SEC_ENAMEL_COLOR = 0xfaf8ef; // Flat enamel colour.
const SEC_DENTIN_COLOR = 0xe3c070; // Flat dentin and section back-face colour.
const SEC_PULP_COLOR = 0xc8505a; // Flat pulp colour.
const SEC_PULP_DEPTH_BIAS = -1; // Depth-buffer bias for pulp; geometry stays on the cut plane.
const SEC_VIEW_DISTANCE = 2.0; // Side-camera distance in total tooth heights.
const SEC_VIEW_Y = 0.08; // Camera target height above box centre in total tooth heights.
const SEC_VIEW_Z = 0.12; // Camera Z offset in total tooth heights, revealing slight depth.
const SEC_CAMERA_LERP = 0.12; // Camera movement fraction per animation frame.
const SEC_CAMERA_EPS = 0.002; // Camera arrival tolerance in scene units.
const SEC_USE_CLOSED_PROXY = false; // Use a schematic watertight shell if the GLB has holes.
const SEC_PROXY_SEGMENTS = 48; // Radial subdivisions of the optional closed proxy.
const SEC_PROXY_PROFILE = [[0,0],[0.06,0.12],[0.28,0.43],[0.58,0.70],[0.83,1],[1,0.76],[1,0]]; // Proxy [height, radius] fractions, from root tip to crown.
const SEC_ORDER = { back: 1, front: 2, base: 3, enamel: 4, dentin: 5, pulp: 6 }; // Explicit ordering within the section render passes.

const secBtn = document.getElementById('secBtn');
const secHint = document.querySelector('.hint');
const secHintHome = secHint.textContent;
const secPlane = new THREE.Plane(new THREE.Vector3(1, 0, 0), 0);
let section = false, secData = null, secTween = null, secHome = null;

function sectionWorldGeometry(m) {
  const g = m.geometry.clone().applyMatrix4(m.matrixWorld);
  // Baking a reflected transform must preserve the original face orientation.
  if (m.matrixWorld.determinant() < 0) {
    if (!g.index) {
      g.setIndex(Array.from({ length: g.attributes.position.count }, (_, i) => i));
    }
    const index = g.index;
    for (let i = 0; i < index.count; i += 3) {
      const a = index.getX(i + 1);
      index.setX(i + 1, index.getX(i + 2));
      index.setX(i + 2, a);
    }
    index.needsUpdate = true;
  }
  return g;
}

function sectionProxy(mid, size, centre) {
  const points = SEC_PROXY_PROFILE.map(([h, r]) =>
    new THREE.Vector2(size.z * r / 2, mid.box.min.y + size.y * h));
  const g = new THREE.LatheGeometry(points, SEC_PROXY_SEGMENTS);
  g.scale(size.x / size.z, 1, 1);
  g.translate(centre.x, 0, centre.z);
  return g;
}

function sectionMask(geometries) {
  const pass = new THREE.Scene();
  const make = (side, op) => new THREE.MeshBasicMaterial({
    side,
    toneMapped: false,
    colorWrite: false,
    depthWrite: false,
    depthTest: false,
    clippingPlanes: [secPlane],
    stencilWrite: true,
    stencilRef: 0,
    stencilFunc: THREE.AlwaysStencilFunc,
    stencilFail: op,
    stencilZFail: op,
    stencilZPass: op
  });
  const back = make(THREE.BackSide, THREE.IncrementWrapStencilOp);
  const front = make(THREE.FrontSide, THREE.DecrementWrapStencilOp);
  geometries.forEach(g => {
    const b = new THREE.Mesh(g, back);
    const f = new THREE.Mesh(g, front);
    b.renderOrder = SEC_ORDER.back;
    f.renderOrder = SEC_ORDER.front;
    b.frustumCulled = f.frustumCulled = false;
    pass.add(b, f);
  });
  return pass;
}

function sectionFaceMaterial(color, clippingPlanes, depthWrite = false) {
  return new THREE.MeshBasicMaterial({
    color,
    side: THREE.DoubleSide,
    toneMapped: false,
    clippingPlanes,
    depthTest: true,
    depthWrite,
    depthFunc: THREE.LessEqualDepth,
    stencilWrite: true,
    stencilRef: 0,
    stencilFunc: THREE.NotEqualStencilFunc,
    stencilFail: THREE.KeepStencilOp,
    stencilZFail: THREE.KeepStencilOp,
    stencilZPass: THREE.KeepStencilOp
  });
}

function initSection() {
  const mid = teeth.find(t => t.spec === TEETH[SEC_TOOTH_INDEX]);
  if (!mid) {
    secBtn.textContent = 'Section unavailable: middle tooth did not load';
    return;
  }
  if (!renderer.getContext().getContextAttributes().stencil) {
    secBtn.textContent = 'Section unavailable: no stencil buffer';
    return;
  }

  mid.wrapper.updateMatrixWorld(true);
  const size = mid.box.getSize(new THREE.Vector3());
  const centre = mid.box.getCenter(new THREE.Vector3());
  const cutX = centre.x + size.x * SEC_CUT_OFFSET;
  const neckY = mid.topY - mid.crownH;
  secPlane.constant = -cutX;
  const crownPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -neckY);

  // Geometry is baked into world space once; wear remains a shared live plane.
  const outer = SEC_USE_CLOSED_PROXY
    ? [sectionProxy(mid, size, centre)]
    : mid.meshes.map(sectionWorldGeometry);

  const e = mid.crownH * SEC_ENAMEL_THICKNESS;
  const inset = new THREE.Matrix4()
    .makeTranslation(centre.x, neckY, centre.z)
    .multiply(new THREE.Matrix4().makeScale(
      Math.max(SEC_MIN_CORE_SCALE, 1 - 2 * e / size.x),
      Math.max(SEC_MIN_CORE_SCALE, 1 - SEC_ENAMEL_THICKNESS),
      Math.max(SEC_MIN_CORE_SCALE, 1 - 2 * e / size.z)
    ))
    .multiply(new THREE.Matrix4().makeTranslation(-centre.x, -neckY, -centre.z));
  const inner = outer.map(g => g.clone().applyMatrix4(inset));

  const shell = new THREE.Group();
  const backMaterial = new THREE.MeshBasicMaterial({
    color: SEC_DENTIN_COLOR,
    side: THREE.BackSide,
    toneMapped: false,
    clippingPlanes: [mid.plane, secPlane]
  });
  outer.forEach(g => shell.add(new THREE.Mesh(g, backMaterial)));
  shell.visible = false;
  scene.add(shell);

  const outerFaces = new THREE.Scene();
  const innerFaces = new THREE.Scene();
  const faceGeometry = new THREE.PlaneGeometry(
    size.z * SEC_CAP_SCALE, size.y * SEC_CAP_SCALE);

  function addFace(pass, color, planes, order, depthWrite = false) {
    const m = new THREE.Mesh(
      faceGeometry, sectionFaceMaterial(color, planes, depthWrite));
    m.rotation.y = -Math.PI / 2;
    m.position.set(cutX, centre.y, centre.z);
    m.renderOrder = order;
    pass.add(m);
  }

  // Identical geometry/transforms keep the colour layers exactly coplanar.
  // Only the first face writes depth; overlays use LEQUAL against that depth.
  addFace(outerFaces, SEC_DENTIN_COLOR, [mid.plane], SEC_ORDER.base, true);
  addFace(outerFaces, SEC_ENAMEL_COLOR,
    [mid.plane, crownPlane], SEC_ORDER.enamel);
  addFace(innerFaces, SEC_DENTIN_COLOR,
    [mid.plane, crownPlane], SEC_ORDER.dentin);

  const z = centre.z + size.z * SEC_PULP_Z_SHIFT;
  const w = size.z * SEC_PULP_HALF_WIDTH;
  const c = size.z * SEC_CANAL_HALF_WIDTH;
  const hornY = mid.topY - mid.crownH * SEC_HORN_DEPTH;
  const chamberY = mid.topY - mid.crownH * SEC_CHAMBER_DEPTH;
  const joinY = mid.box.min.y + size.y * SEC_CANAL_JOIN;
  const tipY = mid.box.min.y + size.y * SEC_APEX_MARGIN;

  // Shape coordinates are (world Z, world Y); rotation maps them onto x=cutX.
  const shape = new THREE.Shape();
  shape.moveTo(z, hornY);
  shape.quadraticCurveTo(z + w, chamberY, z + w, chamberY);
  shape.bezierCurveTo(z + w, neckY, z + c, neckY, z + c, joinY);
  shape.quadraticCurveTo(z + c, tipY, z, tipY);
  shape.quadraticCurveTo(z - c, tipY, z - c, joinY);
  shape.bezierCurveTo(z - c, neckY, z - w, neckY, z - w, chamberY);
  shape.quadraticCurveTo(z - w, chamberY, z, hornY);
  shape.closePath();

  const pulpMaterial = sectionFaceMaterial(SEC_PULP_COLOR, [mid.plane]);
  pulpMaterial.polygonOffset = true;
  pulpMaterial.polygonOffsetFactor = SEC_PULP_DEPTH_BIAS;
  pulpMaterial.polygonOffsetUnits = SEC_PULP_DEPTH_BIAS;
  const sectionPulp = new THREE.Mesh(
    new THREE.ShapeGeometry(shape, SEC_PULP_SEGMENTS), pulpMaterial);
  sectionPulp.rotation.y = -Math.PI / 2;
  sectionPulp.position.x = cutX;
  sectionPulp.renderOrder = SEC_ORDER.pulp;
  innerFaces.add(sectionPulp);

  secData = {
    mid, size, centre, cutX, shell,
    outerMask: sectionMask(outer),
    innerMask: sectionMask(inner),
    outerFaces, innerFaces
  };
  secBtn.disabled = false;
}

function applySection() {
  teeth.forEach(t => {
    const planes = section ? [t.plane, secPlane] : [t.plane];
    t.mats.forEach(m => {
      m.clippingPlanes = planes;
      m.needsUpdate = true;
    });
    t.backs.forEach(b => {
      b.material.clippingPlanes = planes;
      b.material.needsUpdate = true;
      b.visible = !section || t !== secData.mid;
    });
    t.pulp.visible = !section && level >= 3;
  });
  secData.shell.visible = section;
  secBtn.classList.toggle('on', section);
  secBtn.setAttribute('aria-pressed', String(section));
  secBtn.textContent = section
    ? '✂ Section ON: tap to exit'
    : '✂ Section: cut through the middle incisor';
  secHint.textContent = section
    ? 'middle incisor section · drag to orbit · slider changes wear'
    : secHintHome;
}

function moveSectionCamera(position, target) {
  // Flush residual orbit damping before starting a camera transition.
  const damping = controls.enableDamping;
  controls.enableDamping = false;
  controls.update();
  controls.enableDamping = damping;
  secTween = { position: position.clone(), target: target.clone() };
}

function updateSectionCamera() {
  if (!secTween) return;
  camera.position.lerp(secTween.position, SEC_CAMERA_LERP);
  controls.target.lerp(secTween.target, SEC_CAMERA_LERP);
  if (camera.position.distanceTo(secTween.position) < SEC_CAMERA_EPS &&
      controls.target.distanceTo(secTween.target) < SEC_CAMERA_EPS) {
    camera.position.copy(secTween.position);
    controls.target.copy(secTween.target);
    secTween = null;
  }
  camera.lookAt(controls.target);
}

renderer.domElement.addEventListener('pointerdown', () => { secTween = null; });

secBtn.onclick = () => {
  if (!secData) return;
  if (!section) {
    secHome = {
      position: camera.position.clone(),
      target: controls.target.clone()
    };
  }
  section = !section;
  applySection();
  if (section) {
    const { size, centre, cutX } = secData;
    const y = centre.y + size.y * SEC_VIEW_Y;
    moveSectionCamera(
      new THREE.Vector3(
        cutX - size.y * SEC_VIEW_DISTANCE,
        y,
        centre.z + size.y * SEC_VIEW_Z
      ),
      new THREE.Vector3(cutX, y, centre.z)
    );
  } else {
    moveSectionCamera(secHome.position, secHome.target);
  }
};

function renderSection() {
  if (!section || !secData) return;
  const autoClear = renderer.autoClear;
  renderer.autoClear = false;
  try {
    // Preserve the main scene's colour/depth; only stencil is cleared.
    renderer.clearStencil();
    renderer.render(secData.outerMask, camera);
    renderer.render(secData.outerFaces, camera);
    renderer.clearStencil();
    renderer.render(secData.innerMask, camera);
    renderer.render(secData.innerFaces, camera);
  } finally {
    renderer.clearStencil();
    renderer.autoClear = autoClear;
  }
}

function makeBackMat(plane) {
  return new THREE.MeshStandardMaterial({
    color: 0xe2b85c, roughness: 0.85, side: THREE.BackSide,
    clippingPlanes: [plane],
  });
}

async function loadTeeth() {
  for (const spec of TEETH) {
    try {
      const gltf = await new Promise((res, rej) =>
        loader.load(FOLDER + spec.file + '.glb', res, undefined, rej));
      const root = gltf.scene;

      // Centre first (no flip — we're cutting from the bottom)
      let box = new THREE.Box3().setFromObject(root);
      const centre = box.getCenter(new THREE.Vector3());
      root.position.sub(centre);
      root.updateMatrixWorld(true);

      box = new THREE.Box3().setFromObject(root);
      const size = box.getSize(new THREE.Vector3());
      const scale = 1.5 / Math.max(size.x, size.y, size.z);

      const wrapper = new THREE.Group();
      wrapper.add(root);
      wrapper.scale.setScalar(scale);
      wrapper.position.set(spec.x, 0, spec.z);
      wrapper.rotation.y = spec.ry;
      toothGroup.add(wrapper);
      wrapper.updateMatrixWorld(true);

      // Clip plane: normal (0, 1, 0) keeps points with y >= -constant
      // So we set constant = -cutY to keep only points ABOVE cutY.
      // The crown tip (white part) is at the BOTTOM of these models, so
      // we cut from the bottom upward.
      const plane = new THREE.Plane(new THREE.Vector3(0, -1, 0), 999);

      const meshes = [], backs = [];
      root.traverse(o => { if (o.isMesh) meshes.push(o); });
      meshes.forEach(m => {
        const mats = Array.isArray(m.material) ? m.material : [m.material];
        mats.forEach(mt => {
          mt.side = THREE.FrontSide;
          mt.clippingPlanes = [plane];
          mt.needsUpdate = true;
        });
        const back = new THREE.Mesh(m.geometry, makeBackMat(plane));
        m.add(back);
        backs.push(back);
      });

      const wb = new THREE.Box3().setFromObject(wrapper);
      const totalH = wb.max.y - wb.min.y;
      const crownH = totalH * 0.42;   // approximate crown height (top of model)
      const topY = wb.max.y;
      const cx = (wb.min.x + wb.max.x) / 2;
      const cz = (wb.min.z + wb.max.z) / 2;

      // Pulp horn: small red ellipsoid near the crown tip (bottom of model)
      const pulp = new THREE.Mesh(
        new THREE.SphereGeometry(1, 20, 16),
        new THREE.MeshStandardMaterial({
          color: 0xc03838, roughness: 0.6, clippingPlanes: [plane],
        })
      );
      pulp.scale.set(0.05, crownH * 0.28, 0.045);
      pulp.position.set(cx, topY - crownH * 0.72, cz);
      pulp.visible = false;
      toothGroup.add(pulp);

      teeth.push({
        plane, topY, crownH, curFrac: 0, pulp,
        spec, wrapper, box: wb, meshes, backs,
        mats: meshes.flatMap(m => Array.isArray(m.material) ? m.material : [m.material])
      });
    } catch (e) {
      console.error('Failed to load', spec.file, e);
    }
  }
  loading.style.display = 'none';
  setLevel(0);
  try {
    initSection();
  } catch (e) {
    secBtn.disabled = true;
    secBtn.textContent = 'Section unavailable: ' + e.message;
  }
}

function setLevel(l) {
  level = l;
  document.getElementById('valDisplay').textContent = l + ' / 3';
  document.getElementById('stageInfo').innerHTML = MESSAGES[l];
  teeth.forEach(t => { t.pulp.visible = !section && l >= 3; });
}

function updateCuts() {
  const target = WEAR[level];
  teeth.forEach(t => {
    t.curFrac += (target - t.curFrac) * 0.12;
    if (Math.abs(target - t.curFrac) < 0.0005) t.curFrac = target;
    if (t.curFrac <= 0) {
      // No cut — plane sits above the tooth
      t.plane.constant = t.topY + 0.2;
    } else {
      // Plane descends into the crown from above
      const cutY = t.topY - t.crownH * t.curFrac;
      t.plane.constant = cutY;
    }
  });
}

const slider = document.getElementById('slider');
slider.addEventListener('input', () => setLevel(parseInt(slider.value, 10)));
document.querySelectorAll('.presets button[data-v]').forEach(b => {
  b.onclick = () => {
    const v = parseInt(b.dataset.v, 10);
    slider.value = v;
    setLevel(v);
  };
});

window.addEventListener('resize', () => {
  const w = viewer.clientWidth, h = viewer.clientHeight;
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
  renderer.setSize(w, h);
});

function animate() {
  requestAnimationFrame(animate);
  updateCuts();
  controls.update();
  updateSectionCamera();
  renderer.render(scene, camera);
  renderSection();
}

document.getElementById('stageInfo').innerHTML = MESSAGES[0];
loadTeeth();
animate();
</script>
</body></html>
