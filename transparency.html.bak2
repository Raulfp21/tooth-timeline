<!DOCTYPE html>
<html><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Root Transparency — Real Teeth</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#0d1117;color:#e6edf3;font-family:-apple-system,sans-serif;margin:0;font-size:14px;line-height:1.5}
.nav{display:flex;gap:5px;padding:10px;flex-wrap:wrap;background:#161b22;border-bottom:1px solid #30363d;position:sticky;top:0;z-index:10}
.nav a{padding:5px 9px;border-radius:6px;background:#0d1117;color:#e6edf3;text-decoration:none;font-size:11px;border:1px solid #30363d}
.nav a.active{background:#d2a8ff;color:#0d1117;border-color:#d2a8ff}
.wrap{padding:12px;max-width:960px;margin:0 auto}
h1{font-size:16px;margin:0 0 4px}
.sub{font-size:11px;color:#8b949e;margin-bottom:12px}
.viewer{position:relative;background:radial-gradient(circle at center,#1a2029,#0d1117);border-radius:10px;height:52vh;min-height:340px;overflow:hidden;touch-action:none}
.viewer canvas{display:block;width:100%;height:100%}
.hint{position:absolute;top:8px;left:10px;font-size:10px;color:#8b949e;background:rgba(0,0,0,.5);padding:3px 8px;border-radius:4px;pointer-events:none;z-index:2}
.loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#8b949e;font-size:12px;background:rgba(13,17,23,.7);pointer-events:none}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:8px;font-size:11px;color:#c9d1d9}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
.controls{background:#161b22;border-radius:10px;padding:14px;margin-top:12px}
.ctrl-title{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.ctrl-title .name{font-size:15px;font-weight:700;color:#f0883e}
.ctrl-title .val{font-size:13px;color:#d2a8ff;font-weight:700}
input[type=range]{width:100%;-webkit-appearance:none;background:transparent;height:24px;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:5px;background:#30363d;border-radius:3px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;border-radius:50%;background:#f0883e;border:2px solid #0d1117;margin-top:-9px}
.scale{display:flex;justify-content:space-between;font-size:10px;color:#484f58;padding:2px 2px 0}
.stage-info{margin-top:10px;padding:10px;background:#0d1117;border-radius:8px;font-size:12.5px;line-height:1.55;color:#c9d1d9;min-height:70px}
.stage-info strong{color:#f0883e}
.stage-info .m{display:block;margin-top:6px;color:#8b949e}
.presets{display:flex;gap:5px;margin-top:10px;flex-wrap:wrap}
.presets button{flex:1;min-width:55px;padding:8px 4px;border-radius:6px;border:1px solid #30363d;background:#0d1117;color:#e6edf3;font-family:inherit;font-size:11px;font-weight:600}
.presets button:active{background:#f0883e;color:#0d1117}
.jaw button.on{background:#d2a8ff;color:#0d1117;border-color:#d2a8ff}
.note{margin-top:12px;font-size:11.5px;color:#8b949e;line-height:1.55}
</style></head>
<body>
<div class="nav">
<a href="index.html">Timeline</a><a href="learn.html">Learn</a><a href="tooth3d.html">3D</a>
<a href="label3d.html">Label</a><a href="viva.html">Viva</a><a href="gustafson.html">Gustafson</a>
<a href="attrition.html">Attrition</a><a href="periodontosis.html">Periodontosis</a>
<a href="secondary.html">Secondary dentin</a><a href="resorption.html">Root resorption</a>
<a href="transparency.html" class="active">Transparency</a>
<a href="assignments.html">Exam</a><a href="clinic.html">Clinic</a>
</div>
<div class="wrap">
<h1>Transparency of the Root — Lower Lateral Incisor</h1>
<div class="sub">Drag the slider. The glassy zone starts at the apex and advances towards the crown.</div>
<div class="viewer" id="viewer">
  <div class="hint">cut lengthwise · drag to rotate · pinch to zoom</div>
  <div class="loading" id="loading">Loading tooth…</div>
</div>
<div class="legend">
  <span><i style="background:#e2b85c"></i>Opaque dentin</span>
  <span><i style="background:#a8cfc0"></i>Transparent (translucent) dentin</span>
</div>
<div class="controls">
  <div class="ctrl-title"><span class="name">Root transparency</span><span class="val" id="valDisplay">0 / 3</span></div>
  <input type="range" min="0" max="3" step="1" value="0" id="slider">
  <div class="scale"><span>0 · none</span><span>1 · begins</span><span>2 · obvious</span><span>3 · maximum</span></div>
  <div class="stage-info" id="stageInfo"></div>
  <div class="presets">
    <button data-v="0">None</button><button data-v="1">Begins</button>
    <button data-v="2">Obvious</button><button data-v="3">Maximum</button>
  </div>
  <div class="presets jaw">
    <button id="bLower" class="on">Lower jaw tooth</button><button id="bUpper">Upper jaw tooth</button>
  </div>
</div>
<div class="note">Transparency of the root is not seen until about 30 years. The dentinal canals, wide at first, fill with mineral, so the dentin becomes translucent through rarefaction. It is the most reliable of all the criteria. It starts at the apex and moves <strong>upwards in the lower jaw</strong> and <strong>downwards in the upper jaw</strong> (KS Narayan Reddy). The stage extents shown here are illustrative.</div>
</div>

<script type="importmap">
{ "imports": {
  "three": "./libs/three.module.js",
  "three/addons/loaders/GLTFLoader.js": "./libs/GLTFLoader.js",
  "three/addons/controls/OrbitControls.js": "./libs/OrbitControls.js"
} }
</script>
<script type="module">
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const FILE = './models/mandibular_left_lateral_incisor.glb';
const TF = [0, 0.12, 0.28, 0.50];   // transparent length from the apex, as a fraction of tooth height
const MSG = [
  '<strong>Stage 0 — young.</strong> No transparency. The root dentin is opaque, with wide dentinal canals.',
  '<strong>Stage 1 — beginning.</strong> The first translucency appears at the apex, where canals fill with mineral first.',
  '<strong>Stage 2 — obvious.</strong> The translucent zone has advanced up the root. In a lower-jaw tooth it moves from below upwards.',
  '<strong>Stage 3 — maximum.</strong> Most of the root is transparent. This is the most reliable of the Gustafson criteria.'
];
const DIR_NOTE = { lower: 'Lower jaw: advancing from the apex upwards.', upper: 'Upper jaw: advancing from the apex downwards (tooth is inverted).' };

const viewer = document.getElementById('viewer');
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(viewer.clientWidth, viewer.clientHeight);
renderer.localClippingEnabled = true;
viewer.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(38, viewer.clientWidth / viewer.clientHeight, 0.01, 200);
camera.position.set(8, 0.3, 0.4);
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true; controls.enablePan = false;
controls.minDistance = 3; controls.maxDistance = 11;
scene.add(new THREE.AmbientLight(0xffffff, 0.8));
const key = new THREE.DirectionalLight(0xffffff, 1.1); key.position.set(5, 3, 4); scene.add(key);
const fillLight = new THREE.DirectionalLight(0xaaccff, 0.5); fillLight.position.set(-4, 1, -2); scene.add(fillLight);

const cutPlane = new THREE.Plane(new THREE.Vector3(-1, 0, 0), 0);   // keeps x <= 0
const opPlane  = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);    // keeps the opaque part
const glPlane  = new THREE.Plane(new THREE.Vector3(0, -1, 0), 0);   // keeps the glassy part

let pg = null, wrapper = null, H = 1, yA = 0, jaw = 'lower', level = 0, cur = 0;

function apexY() {
  wrapper.updateMatrixWorld(true);
  const b = new THREE.Box3().setFromObject(wrapper);
  H = b.max.y - b.min.y;
  return jaw === 'lower' ? b.min.y : b.max.y;
}
function updatePlanes(f) {
  const up = jaw === 'upper', yT = up ? yA - f * H : yA + f * H;
  if (!up) { opPlane.normal.set(0, 1, 0);  opPlane.constant = -yT; glPlane.normal.set(0, -1, 0); glPlane.constant = yT; }
  else     { opPlane.normal.set(0, -1, 0); opPlane.constant = yT;  glPlane.normal.set(0, 1, 0);  glPlane.constant = -yT; }
}
function setLevel(l) {
  level = l;
  document.getElementById('valDisplay').textContent = l + ' / 3';
  document.getElementById('stageInfo').innerHTML = MSG[l] + '<span class="m">' + DIR_NOTE[jaw] + ' (illustrative)</span>';
}
function setJaw(j) {
  jaw = j;
  document.getElementById('bLower').classList.toggle('on', j === 'lower');
  document.getElementById('bUpper').classList.toggle('on', j === 'upper');
  if (wrapper) { wrapper.rotation.x = j === 'upper' ? Math.PI : 0; if (pg) pg.rotation.x = wrapper.rotation.x; yA = apexY(); updatePlanes(cur); }
  setLevel(level);
}

new GLTFLoader().load(FILE, gltf => {
  const root = gltf.scene;
  let box = new THREE.Box3().setFromObject(root);
  root.position.sub(box.getCenter(new THREE.Vector3()));
  root.updateMatrixWorld(true);
  box = new THREE.Box3().setFromObject(root);
  const sz = box.getSize(new THREE.Vector3());
  wrapper = new THREE.Group();
  wrapper.add(root);
  wrapper.scale.setScalar(2.6 / Math.max(sz.x, sz.y, sz.z));
  scene.add(wrapper);

  const backMat = new THREE.MeshStandardMaterial({ color: 0xe2b85c, roughness: 0.85, side: THREE.BackSide, clippingPlanes: [cutPlane, opPlane] });
  const gFront = new THREE.MeshStandardMaterial({ color: 0xcfe3e6, roughness: 0.2, transparent: true, opacity: 0.28, depthWrite: false, side: THREE.FrontSide, clippingPlanes: [cutPlane, glPlane] });
  const gBack  = new THREE.MeshStandardMaterial({ color: 0xa8cfc0, roughness: 0.3, transparent: true, opacity: 0.5, depthWrite: false, side: THREE.BackSide, clippingPlanes: [cutPlane, glPlane] });

  const meshes = [];
  root.traverse(o => { if (o.isMesh) meshes.push(o); });
  meshes.forEach(m => {
    (Array.isArray(m.material) ? m.material : [m.material]).forEach(mt => {
      mt.side = THREE.FrontSide; mt.clippingPlanes = [cutPlane, opPlane]; mt.needsUpdate = true;
    });
    m.add(new THREE.Mesh(m.geometry, backMat));
    m.add(new THREE.Mesh(m.geometry, gBack));
    m.add(new THREE.Mesh(m.geometry, gFront));
  });

  yA = apexY();
  updatePlanes(0);

  // red pulp, sized for an older tooth (illustrative)
  {
    const verts = [], v = new THREE.Vector3();
    wrapper.updateMatrixWorld(true);
    meshes.forEach(m => {
      m.updateWorldMatrix(true, false);
      const pa = m.geometry.attributes.position;
      for (let i = 0; i < pa.count; i++) { v.fromBufferAttribute(pa, i).applyMatrix4(m.matrixWorld); verts.push(v.x, v.y, v.z); }
    });
    const wb = new THREE.Box3().setFromObject(wrapper), HH = wb.max.y - wb.min.y;
    const Y0 = wb.min.y + 0.05 * HH, Y1 = wb.max.y - 0.08 * HH, sl = [];
    for (let k = 0; k <= 8; k++) {
      const y = Y0 + (Y1 - Y0) * k / 8;
      let n = 0, a = 1e9, b = -1e9, c = 1e9, d = -1e9;
      for (let i = 0; i < verts.length; i += 3) {
        if (Math.abs(verts[i + 1] - y) < 0.03 * HH) {
          n++; a = Math.min(a, verts[i]); b = Math.max(b, verts[i]); c = Math.min(c, verts[i + 2]); d = Math.max(d, verts[i + 2]);
        }
      }
      if (n > 3) sl.push({ y, cx: (a + b) / 2, cz: (c + d) / 2, hx: (b - a) / 2, hz: (d - c) / 2 });
    }
    if (sl.length > 1) {
      const at = y => {
        if (y <= sl[0].y) return sl[0];
        for (let i = 1; i < sl.length; i++) if (y <= sl[i].y) {
          const A = sl[i - 1], B = sl[i], t = (y - A.y) / (B.y - A.y), L = q => A[q] + (B[q] - A[q]) * t;
          return { cx: L('cx'), cz: L('cz'), hx: L('hx'), hz: L('hz') };
        }
        return sl[sl.length - 1];
      };
      const frac = t => {
        const x = Math.min(1, Math.max(0, (t - 0.15) / 0.55));
        let f = 0.35 + 0.65 * x * x * (3 - 2 * x);
        if (t > 0.86) { const q = (t - 0.86) / 0.14; f *= Math.sqrt(Math.max(0, 1 - q * q)); }
        return f;
      };
      const NR = 28, NS = 24, SC = 0.62 * 0.28, LN = 0.8;   // older-adult pulp
      const pos = new Float32Array((NR + 1) * (NS + 1) * 3), idx = [];
      for (let i = 0; i <= NR; i++) {
        const t = i / NR, y = Y0 + t * (Y1 - Y0) * LN, c = at(y), f = frac(t) * SC;
        for (let j = 0; j <= NS; j++) {
          const an = (j / NS) * Math.PI * 2, o = (i * (NS + 1) + j) * 3;
          pos[o] = c.cx + Math.cos(an) * f * c.hx; pos[o + 1] = y; pos[o + 2] = c.cz + Math.sin(an) * f * c.hz;
        }
      }
      for (let i = 0; i < NR; i++) for (let j = 0; j < NS; j++) {
        const A = i * (NS + 1) + j, B = A + 1, C = A + NS + 1, D = C + 1; idx.push(A, B, C, B, D, C);
      }
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(pos, 3)); g.setIndex(idx); g.computeVertexNormals();
      const pm = new THREE.Mesh(g, new THREE.MeshStandardMaterial({ color: 0xc03838, roughness: 0.7, side: THREE.DoubleSide, clippingPlanes: [cutPlane] }));
      pm.frustumCulled = false;
      pg = new THREE.Group(); pg.add(pm); scene.add(pg);
      cutPlane.constant = at((Y0 + Y1) / 2).cx;   // cut through the pulp's centre
    } else console.error('could not measure tooth');
  }
  document.getElementById('loading').style.display = 'none';
  setJaw(jaw);
}, undefined, e => { document.getElementById('loading').textContent = 'Could not load model'; console.error(e); });

const slider = document.getElementById('slider');
slider.addEventListener('input', () => setLevel(parseInt(slider.value, 10)));
document.querySelectorAll('.presets button[data-v]').forEach(b => {
  b.onclick = () => { const v = parseInt(b.dataset.v, 10); slider.value = v; setLevel(v); };
});
document.getElementById('bLower').onclick = () => setJaw('lower');
document.getElementById('bUpper').onclick = () => setJaw('upper');
window.addEventListener('resize', () => {
  camera.aspect = viewer.clientWidth / viewer.clientHeight; camera.updateProjectionMatrix();
  renderer.setSize(viewer.clientWidth, viewer.clientHeight);
});

function animate() {
  requestAnimationFrame(animate);
  if (wrapper) {
    const t = TF[level];
    if (Math.abs(t - cur) > 0.0005) { cur += (t - cur) * 0.12; updatePlanes(cur); }
  }
  controls.update();
  renderer.render(scene, camera);
}
document.getElementById('stageInfo').innerHTML = MSG[0];
animate();
</script>
</body></html>
